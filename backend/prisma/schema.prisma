generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid()) @map("_id")
  fullName      String
  email         String    @unique
  password      String
  role          String    @default("EMPLOYEE")
  department    String?
  isActive      Boolean   @default(true)
  currentStatus String    @default("OFF_WORK")
  projectId     String?
  pushEnabled   Boolean   @default(true)
  timeLogs      TimeLog[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Project {
  id               String               @id @default(cuid()) @map("_id")
  name             String
  description      String?
  status           String               @default("Planning")
  projectManagerId String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  tasks            Task[]
  requirements     ClientRequirement[]
}

model ClientRequirement {
  id          String   @id @default(cuid()) @map("_id")
  title       String
  description String?
  priority    String   @default("Medium")
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  tasks       Task[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Task {
  id            String             @id @default(cuid()) @map("_id")
  title         String
  description   String?
  status        String             @default("Pending")
  assignee      String?
  projectId     String
  project       Project            @relation(fields: [projectId], references: [id])
  requirementId String?
  requirement   ClientRequirement? @relation(fields: [requirementId], references: [id])
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model TimeLog {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "CHECK_IN", "CHECK_OUT", "BREAK_START", "BREAK_END", "LUNCH_START", "LUNCH_END"
  timestamp DateTime @default(now())
  notes     String?
}

model UserPublicKey {
  id            String   @id @default(cuid()) @map("_id")
  userId        String   @unique
  ecdhPublicKey String   // Exported JWK ECDH public key
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MessageGroup {
  id          String   @id @default(cuid()) @map("_id")
  name        String
  role        String?  // Mapped to specific role channels (e.g. ADMIN)
  projectId   String?  // Mapped to specific project channels
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GroupKey {
  id           String   @id @default(cuid()) @map("_id")
  groupId      String
  userId       String
  encryptedKey String   // AES group symmetric key, encrypted for the specific user via their ECDH public key
  iv           String   // Base64 IV used for encrypting the key
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([groupId, userId])
}

model ChatMessage {
  id               String   @id @default(cuid()) @map("_id")
  senderId         String
  recipientId      String?
  groupId          String?
  encryptedContent String   // Encrypted text content or file reference
  iv               String   // Base64 IV
  mediaUrl         String?  // Cloudinary upload url
  mediaIv          String?  // Base64 media IV
  mediaName        String?  // File name
  mediaType        String?  // "image", "audio", "pdf", "file"
  createdAt        DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid()) @map("_id")
  userId    String   @unique
  endpoint  String
  auth      String
  p256dh    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

